# --- Database ---------------------------------------------------------------
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/
DB_NAME=seo_reporting

# --- Sessions ---------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256

# --- "Connect Google account" (OAuth web client) -----------------------------
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxx
# Must match the "Authorized redirect URI" on the OAuth client exactly.
GOOGLE_OAUTH_REDIRECT_URI=https://seoreportingbackend.fastapicloud.dev/api/v1/integrations/google/callback
# Where the backend sends the browser after Google sign-in.
FRONTEND_URL=https://forma-tas.vercel.app
# Encrypts stored Google refresh tokens. Generate once and never change it
# (changing it makes every stored connection unreadable):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- CORS (comma-separated frontend origins) --------------------------------
CORS_ORIGINS=https://forma-tas.vercel.app

# --- Monthly scheduler -------------------------------------------------------
# Secret for POST /api/v1/internal/cron/monthly (header X-Cron-Secret).
CRON_SECRET=change-me
# Optional Slack/Teams-style webhook for failed scheduled reports.
NOTIFY_WEBHOOK_URL=

# --- Legacy service-account fallback (only for manually added clients) -------
# GSC_SERVICE_ACCOUNT_JSON= / GA4_SERVICE_ACCOUNT_JSON= / GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# Google PageSpeed Insights API
PAGESPEED_API_KEY=
